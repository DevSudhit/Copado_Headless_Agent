# Copy values from here into a local .env file or export them in your shell.
# Never commit real secrets.

# Copado CI/CD Playground
# Main Copado playground org username
COPADO_COPADO_ORG_USERNAME=sudhitjain@310526cph.com

# Main Copado CI/CD API server URL shown in the Personal API Key screen
COPADO_CICD_BASE_URL=https://na.api.copado.com

# Paste the Personal API key from the Copado API screen into a local .env only
COPADO_CICD_TOKEN=

# Scratch orgs provisioned by the source-format playground
COPADO_DEV1_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.dev1-sfp
COPADO_DEV2_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.dev2-sfp
COPADO_INT_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.int-sfp
COPADO_UAT_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.uat-sfp
COPADO_HOTFIX_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.hotfix-sfp
COPADO_PROD_SCRATCH_ORG_USERNAME=sudhitjain@310526cph.com.production-sfp

# Copado AI Platform
# EU region API base URL inferred from your Copado robotic host
COPADO_AI_BASE_URL=https://copadogpt-api.eu-robotic.copado.com
COPADO_AI_TOKEN=

# Confirmed from the robotic platform URL: https://eu-robotic.copado.com/ai/?orgId=43877
COPADO_AI_ORGANIZATION_ID=43877

# Confirmed from the workspace URL: https://eu-robotic.copado.com/ai/workspaces/74df93c0-1ace-4a14-9027-0df049fcdd6a
COPADO_AI_WORKSPACE_ID=74df93c0-1ace-4a14-9027-0df049fcdd6a

# Copado Robotic Testing
# CRT service provider selected during setup
COPADO_CRT_SERVICE_PROVIDER=COPADO_CICD

# CRT is currently linked to this Copado CI/CD host
COPADO_CRT_LINKED_CICD_BASE_URL=https://copadotrial11489283.lightning.force.com

# Non-secret CRT integration key name created during setup
COPADO_CRT_SERVICE_KEY_NAME=copadoCICD_copadotrial11489283.lightning.force.com

# Product host seen in the Copado robotic platform. Keep this unless CRT shows a different base host.
COPADO_CRT_BASE_URL=https://eu-robotic.copado.com

# Confirmed from the CRT URL: https://eu-robotic.copado.com/?orgId=43844&projectId=76606
COPADO_CRT_ORGANIZATION_ID=43844
COPADO_CRT_PROJECT_ID=76606

# Paste only a freshly rotated CRT token here. Never reuse one that was exposed.
COPADO_CRT_TOKEN=

# Optional local note
COPADO_ACTIVE_PROFILE=playground
